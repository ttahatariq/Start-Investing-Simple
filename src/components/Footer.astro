---
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <p class="text-base font-bold text-paper">Start Investing Simple<span class="text-brand">/</span></p>
        <p class="mt-3 text-sm text-muted">
          Plain-English guides to help beginners understand investing, saving, and money basics — no jargon, no hype.
        </p>
      </div>

      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-muted">Explore<span class="text-orange">/</span></p>
        <ul class="mt-3 space-y-2 text-sm text-paper/80">
          <li><a href="/blog/" class="hover:text-brand">Articles</a></li>
          <li><a href="/tools/" class="hover:text-brand">Tools & Calculators</a></li>
          <li><a href="/about/" class="hover:text-brand">About</a></li>
          <li><a href="/contact/" class="hover:text-brand">Contact</a></li>
        </ul>
      </div>

      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-muted">Legal<span class="text-orange">/</span></p>
        <ul class="mt-3 space-y-2 text-sm text-paper/80">
          <li><a href="/privacy-policy/" class="hover:text-brand">Privacy Policy</a></li>
          <li><a href="/disclaimer/" class="hover:text-brand">Disclaimer</a></li>
          <li><a href="/terms/" class="hover:text-brand">Terms of Use</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-6 font-mono text-xs text-muted">
      <p>&copy; {year} Start Investing Simple. All rights reserved.</p>
      <p class="mt-2 max-w-2xl leading-relaxed">
        Start Investing Simple is an educational resource only and does not provide personalized financial,
        investment, tax, or legal advice. See our <a href="/disclaimer/" class="underline hover:text-brand">disclaimer</a> for details.
      </p>
    </div>
  </div>
</footer>
