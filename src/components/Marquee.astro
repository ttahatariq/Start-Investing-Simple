---
interface Props {
  items: string[];
}
const { items } = Astro.props;
const track = [...items, ...items];
---

<div class="overflow-hidden border-y border-line bg-surface py-4">
  <div class="flex w-max marquee-track">
    {track.map((item) => (
      <span class="mx-6 flex items-center gap-6 font-mono text-sm uppercase tracking-wider text-muted whitespace-nowrap">
        {item}
        <span class="text-brand">/</span>
      </span>
    ))}
  </div>
</div>
