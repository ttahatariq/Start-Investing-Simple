---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class={compact ? '' : 'corner-card rounded-sm bg-surface p-6 sm:p-8'}>
  {!compact && (
    <>
      <p class="font-mono text-xs uppercase tracking-widest text-brand">Stay Updated<span class="text-orange">/</span></p>
      <h2 class="mt-2 text-2xl font-bold text-paper">Get new articles by email</h2>
      <p class="mt-2 max-w-lg text-sm text-muted">
        A short email whenever we publish a new article or calculator. No spam, unsubscribe anytime.
      </p>
    </>
  )}
  <form
    action="https://buttondown.com/api/emails/embed-subscribe/tahatariq273"
    method="post"
    target="_blank"
    class={compact ? 'flex flex-col gap-3 sm:flex-row' : 'mt-5 flex flex-col gap-3 sm:flex-row'}
  >
    <label for="bd-email" class="sr-only">Enter your email</label>
    <input
      type="email"
      name="email"
      id="bd-email"
      required
      placeholder="you@example.com"
      class="w-full flex-1 rounded-sm border border-line bg-ink px-3 py-2 text-sm text-paper placeholder:text-muted focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand sm:max-w-xs"
    />
    <button
      type="submit"
      class="shrink-0 rounded-sm bg-brand px-5 py-2 font-mono text-xs font-semibold uppercase tracking-wide text-ink hover:bg-brand-dim"
    >
      Subscribe
    </button>
  </form>
  <p class="mt-3 font-mono text-[11px] text-muted/70">
    Powered by <a href="https://buttondown.com/refer/tahatariq273" target="_blank" rel="noopener" class="underline hover:text-brand">Buttondown</a>.
    See our <a href="/privacy-policy/" class="underline hover:text-brand">privacy policy</a>.
  </p>
</div>
