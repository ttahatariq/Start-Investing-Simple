---
import Layout from './Layout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareButtons from '../components/ShareButtons.astro';
import FAQSection from '../components/FAQSection.astro';
import { categorySlug } from '../lib/category';

interface RelatedPost {
  id: string;
  title: string;
  category: string;
  description: string;
}

interface FAQ {
  question: string;
  answer: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  tags: string[];
  heroImage?: string;
  readingTimeMinutes?: number;
  relatedPosts?: RelatedPost[];
  headings?: Heading[];
  faqs?: FAQ[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  tags,
  heroImage,
  readingTimeMinutes,
  relatedPosts = [],
  headings = [],
  faqs = [],
} = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const absoluteUrl = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: 'Start Investing Simple' },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:grid lg:grid-cols-[1fr_240px] lg:items-start lg:gap-16">
    <article class="max-w-3xl">
      {heroImage && (
        <div class="corner-card mb-10 overflow-hidden rounded-sm">
          <img src={heroImage} alt="" class="h-56 w-full object-cover sm:h-72" loading="eager" />
        </div>
      )}

      <header class="mb-10 border-b border-line pb-8">
        <a href={`/category/${categorySlug(category)}/`} class="font-mono text-xs uppercase tracking-widest text-brand hover:underline">{category}<span class="text-orange">/</span></a>
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-paper sm:text-4xl">{title}</h1>
        <p class="mt-4 text-lg text-muted">{description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted/70">
          <span>By {author}</span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={pubDate.toISOString()}>Published {formatDate(pubDate)}</time>
          {updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <time datetime={updatedDate.toISOString()}>Updated {formatDate(updatedDate)}</time>
            </>
          )}
          {readingTimeMinutes && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>{readingTimeMinutes} min read</span>
            </>
          )}
        </div>

        <div class="mt-6">
          <ShareButtons url={absoluteUrl} title={title} />
        </div>

        <nav aria-label="Table of contents" class="mt-6 rounded-sm border border-line bg-surface p-4 lg:hidden">
          <p class="font-mono text-xs uppercase tracking-wider text-muted">On this page<span class="text-orange">/</span></p>
          <ul class="mt-2 space-y-1">
            {headings.map((h) => (
              <li class={h.depth === 3 ? 'pl-4' : ''}>
                <a href={`#${h.slug}`} class="text-sm text-muted hover:text-brand">{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </header>

      <div class="prose prose-invert max-w-none prose-headings:font-bold prose-a:text-brand prose-a:no-underline hover:prose-a:underline prose-strong:text-paper">
        <slot />
      </div>

      {tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2 border-t border-line pt-6">
          {tags.map((tag) => (
            <span class="rounded-sm border border-line px-3 py-1 font-mono text-xs text-muted">#{tag}</span>
          ))}
        </div>
      )}

      <div class="corner-card mt-10 rounded-sm bg-surface p-4 text-sm text-paper/80">
        <strong class="text-orange">Disclaimer:</strong> This article is for educational purposes only and is not personalized financial,
        investment, tax, or legal advice. Always do your own research or consult a licensed professional before making
        financial decisions. See our full <a href="/disclaimer/" class="text-brand underline">disclaimer</a>.
      </div>

      <FAQSection faqs={faqs} />

      <AuthorBio author={author} />
    </article>

    <TableOfContents headings={headings} />
  </div>

  {relatedPosts.length > 0 && (
    <section class="border-t border-line bg-surface">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
        <h2 class="text-xl font-bold text-paper">
          Keep <span class="text-muted">reading</span><span class="text-orange">/</span>
        </h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {relatedPosts.map((post) => (
            <a href={`/blog/${post.id}/`} class="corner-card block rounded-sm bg-ink p-5 transition hover:bg-surface-2">
              <p class="font-mono text-xs uppercase tracking-wide text-brand">{post.category}</p>
              <h3 class="mt-2 text-sm font-semibold text-paper">{post.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
