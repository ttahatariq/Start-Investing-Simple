---
import Layout from '../layouts/Layout.astro';

// TODO: Replace with your real contact email.
const contactEmail = 'hello@startinvestingsimple.com';
---

<Layout
  title="Contact"
  description="Get in touch with the Start Investing Simple team with questions, feedback, or corrections."
>
  <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-widest text-brand">Get in touch<span class="text-orange">/</span></p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-paper sm:text-4xl">Contact Us</h1>
    <p class="mt-4 text-lg text-muted">
      Have a question, spotted an error, or want to suggest a topic? We'd love to hear from you.
    </p>

    <div class="corner-card mt-8 rounded-sm bg-surface p-6">
      <p class="font-mono text-xs uppercase tracking-wide text-muted">Email</p>
      <a href={`mailto:${contactEmail}`} class="mt-1 inline-block text-brand hover:underline">
        {contactEmail}
      </a>
      <p class="mt-4 text-sm text-muted">
        We read every message and try to respond within a few business days. Please note we can't provide
        personalized financial advice — see our <a href="/disclaimer/" class="text-brand underline">disclaimer</a>.
      </p>
    </div>
  </div>
</Layout>
