---
import Layout from '../layouts/Layout.astro';
import MarketOverviewWidget from '../components/MarketOverviewWidget.astro';
---

<Layout
  title="Live Markets"
  description="Track major stock indices, individual stocks, futures, bonds, and forex in real time."
>
  <section
    class="border-b border-line bg-cover bg-center"
    style="background-image: linear-gradient(to bottom, rgba(9,9,11,0.55), rgba(9,9,11,0.95)), url(/img/stocks-chart.jpg);"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-widest text-brand">Live Data<span class="text-orange">/</span></p>
      <h1 class="mt-3 max-w-2xl text-4xl font-extrabold tracking-tight text-paper sm:text-5xl">
        Markets<span class="text-orange">,</span> live<span class="text-brand">/</span>
      </h1>
      <p class="mt-4 max-w-xl text-lg text-muted">
        Track major indices, stocks, futures, bonds, and currencies — updated continuously throughout the trading day.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="corner-card rounded-sm bg-surface p-4 sm:p-6">
      <MarketOverviewWidget />
    </div>

    <p class="mt-6 max-w-2xl text-xs text-muted">
      Market data is provided by TradingView and may be delayed 15-20 minutes depending on the exchange. This
      information is for general educational purposes only and is not personalized investment advice — see our
      <a href="/disclaimer/" class="text-brand underline">disclaimer</a>.
    </p>
  </section>
</Layout>
