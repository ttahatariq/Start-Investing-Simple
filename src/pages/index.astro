---
import Layout from '../layouts/Layout.astro';
import StockTickerTape from '../components/StockTickerTape.astro';
import { getCollection } from 'astro:content';
import { categorySlug } from '../lib/category';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const stats = [
  { value: String(allPosts.length) + '+', label: 'Free articles' },
  { value: '4', label: 'Free calculators' },
  { value: '100%', label: 'Free, always' },
  { value: '0%', label: 'Sales pitch' },
];

const pillars = [
  {
    title: 'Investing Basics',
    description: 'Stocks, bonds, index funds, and how markets actually work — explained without jargon.',
    accent: 'text-brand',
  },
  {
    title: 'Saving & Budgeting',
    description: 'Practical habits for building an emergency fund and making your paycheck go further.',
    accent: 'text-aqua',
  },
  {
    title: 'Retirement Planning',
    description: 'How 401(k)s, IRAs, and compound growth work together over the long run.',
    accent: 'text-violet',
  },
];

const tools = [
  { href: '/tools/compound-interest-calculator/', title: 'Compound Interest', description: 'See how your money could grow over time.' },
  { href: '/tools/retirement-calculator/', title: 'Retirement Savings', description: 'Project your savings and a sustainable withdrawal.' },
  { href: '/tools/budget-calculator/', title: '50/30/20 Budget', description: 'Split your income into needs, wants, and savings.' },
  { href: '/tools/debt-payoff-calculator/', title: 'Debt Payoff', description: 'Compare snowball vs. avalanche for your own debts.' },
];
---

<Layout
  title="Start Investing Simple"
  description="Plain-English guides to investing, saving, and money basics for beginners. No jargon, no hype — just clear explanations to help you get started."
>
  <section
    class="border-b border-line bg-cover bg-center"
    style="background-image: linear-gradient(to bottom, rgba(9,9,11,0.65), rgba(9,9,11,0.97)), url(/img/hero-skyline.jpg);"
  >
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-widest text-brand">Personal Finance, Simplified<span class="text-orange">/</span></p>
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-[1.05] tracking-tight text-paper sm:text-6xl">
        Investing<span class="text-orange">,</span> explained
        <span class="text-muted">simply</span><span class="text-brand">/</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted">
        Clear, beginner-friendly guides to help you understand investing and money — without the jargon,
        the hype, or the sales pitch.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/blog/" class="rounded-sm bg-brand px-6 py-3 font-mono text-sm font-semibold uppercase tracking-wide text-ink hover:bg-brand-dim">
          Start Reading
        </a>
        <a href="/tools/" class="rounded-sm border border-line px-6 py-3 font-mono text-sm font-semibold uppercase tracking-wide text-paper hover:border-brand hover:text-brand">
          Try Our Calculators
        </a>
      </div>
    </div>
  </section>

  <StockTickerTape />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
      {stats.map((stat) => (
        <div class="corner-card rounded-sm bg-surface px-4 py-6 text-center">
          <p class="text-3xl font-extrabold text-brand sm:text-4xl">{stat.value}</p>
          <p class="mt-1 font-mono text-xs uppercase tracking-wider text-muted">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="text-2xl font-bold text-paper">
        What you'll <span class="text-muted">learn</span><span class="text-orange">/</span>
      </h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {pillars.map((pillar) => (
          <a href={`/category/${categorySlug(pillar.title)}/`} class="corner-card block rounded-sm bg-ink p-6 transition hover:bg-surface-2">
            <h3 class={`text-lg font-semibold ${pillar.accent}`}>{pillar.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{pillar.description}</p>
            <p class="mt-4 font-mono text-xs uppercase tracking-wider text-brand">Browse articles &rarr;</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-paper">
        Free <span class="text-muted">calculators</span><span class="text-orange">/</span>
      </h2>
      <a href="/tools/" class="font-mono text-xs uppercase tracking-wider text-brand hover:underline">View all &rarr;</a>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {tools.map((tool) => (
        <a href={tool.href} class="corner-card block rounded-sm bg-surface p-5 transition hover:bg-surface-2">
          <p class="font-mono text-xs uppercase tracking-wide text-aqua">Calculator</p>
          <h3 class="mt-2 text-base font-semibold text-paper">{tool.title}</h3>
          <p class="mt-2 text-sm text-muted">{tool.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="corner-card flex flex-col items-start gap-6 rounded-sm bg-ink p-8 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-brand">Live Data<span class="text-orange">/</span></p>
          <h2 class="mt-2 text-2xl font-bold text-paper">Track markets in real time</h2>
          <p class="mt-2 max-w-lg text-sm text-muted">
            Indices, stocks, bonds, commodities, and forex — updated continuously throughout the trading day, free.
          </p>
        </div>
        <a href="/markets/" class="shrink-0 rounded-sm bg-brand px-6 py-3 font-mono text-sm font-semibold uppercase tracking-wide text-ink hover:bg-brand-dim">
          View Live Markets
        </a>
      </div>
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-paper">
          Latest <span class="text-muted">articles</span><span class="text-orange">/</span>
        </h2>
        <a href="/blog/" class="font-mono text-xs uppercase tracking-wider text-brand hover:underline">View all &rarr;</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {latestPosts.map((post) => (
          <a href={`/blog/${post.id}/`} class="corner-card block rounded-sm bg-surface p-6 transition hover:bg-surface-2">
            <p class="font-mono text-xs uppercase tracking-wide text-brand">{post.data.category}</p>
            <h3 class="mt-3 text-lg font-semibold text-paper">{post.data.title}</h3>
            <p class="mt-2 text-sm text-muted line-clamp-3">{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
