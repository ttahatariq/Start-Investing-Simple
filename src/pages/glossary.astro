---
import Layout from '../layouts/Layout.astro';
import { glossaryTerms } from '../lib/glossary';

const sorted = [...glossaryTerms].sort((a, b) => a.term.localeCompare(b.term));

const groups = new Map<string, typeof sorted>();
for (const item of sorted) {
  const letter = item.term.charAt(0).toUpperCase();
  if (!groups.has(letter)) groups.set(letter, []);
  groups.get(letter)!.push(item);
}
const letters = [...groups.keys()];
---

<Layout
  title="Finance Glossary"
  description="A plain-English glossary of common investing and personal finance terms, from 401(k) to zero-based budgeting."
>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-widest text-brand">Reference<span class="text-orange">/</span></p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-paper sm:text-4xl">Finance Glossary</h1>
    <p class="mt-3 text-lg text-muted">
      Plain-English definitions for common investing and personal finance terms — no jargon explaining jargon.
    </p>

    <input
      type="search"
      id="glossary-search"
      placeholder="Search terms…"
      class="mt-8 w-full rounded-sm border border-line bg-surface px-4 py-3 text-paper placeholder:text-muted focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
    />

    <nav aria-label="Jump to letter" class="mt-6 flex flex-wrap gap-2">
      {letters.map((letter) => (
        <a
          href={`#letter-${letter}`}
          class="flex h-8 w-8 items-center justify-center rounded-sm border border-line font-mono text-xs text-muted hover:border-brand hover:text-brand"
        >
          {letter}
        </a>
      ))}
    </nav>

    <div id="glossary-list" class="mt-10 space-y-12">
      {letters.map((letter) => (
        <section id={`letter-${letter}`}>
          <h2 class="border-b border-line pb-2 font-mono text-sm uppercase tracking-wider text-brand">{letter}</h2>
          <dl class="mt-4 space-y-6">
            {groups.get(letter)!.map((item) => (
              <div class="glossary-term" data-term={item.term.toLowerCase()}>
                <dt class="text-lg font-semibold text-paper">{item.term}</dt>
                <dd class="mt-1 text-muted">
                  {item.definition}
                  {item.link && (
                    <>
                      {' '}
                      <a href={item.link} class="text-brand underline">Read more &rarr;</a>
                    </>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>

    <p id="glossary-empty" class="mt-10 hidden text-muted">No terms match your search.</p>
  </div>
</Layout>

<script>
  const input = document.getElementById('glossary-search') as HTMLInputElement | null;
  const terms = Array.from(document.querySelectorAll<HTMLElement>('.glossary-term'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('#glossary-list > section'));
  const emptyMsg = document.getElementById('glossary-empty');

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let anyVisible = false;

    terms.forEach((el) => {
      const match = !q || (el.dataset.term ?? '').includes(q) || el.textContent!.toLowerCase().includes(q);
      el.classList.toggle('hidden', !match);
      if (match) anyVisible = true;
    });

    sections.forEach((section) => {
      const hasVisible = Array.from(section.querySelectorAll('.glossary-term')).some(
        (el) => !el.classList.contains('hidden'),
      );
      section.classList.toggle('hidden', !hasVisible);
    });

    emptyMsg?.classList.toggle('hidden', anyVisible || !q);
  });
</script>
