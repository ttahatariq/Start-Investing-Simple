---
import Layout from '../../layouts/Layout.astro';
import NetWorthCalculator from '../../components/NetWorthCalculator';
---

<Layout
  title="Net Worth Calculator"
  description="Free net worth calculator. Add your assets and liabilities to see your net worth, with your numbers saved privately in your own browser."
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-widest text-brand">Tool<span class="text-orange">/</span></p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-paper sm:text-4xl">Net Worth Calculator</h1>
    <p class="mt-3 text-lg text-muted">
      List what you own and what you owe to see your net worth — update it anytime to track how it changes.
    </p>

    <div class="mt-8">
      <NetWorthCalculator client:load />
    </div>

    <div class="prose prose-invert mt-10 max-w-none prose-a:text-brand">
      <h2>How this calculator works</h2>
      <p>
        Net worth is simply total assets minus total liabilities. Add or remove line items on either side to
        match your own situation, and your entries are saved locally in your browser so you can return and
        update them later without starting over.
      </p>
      <p>
        Read our full guide on <a href="/blog/what-is-net-worth/">what net worth actually measures and why it's
        worth tracking</a> for more context.
      </p>
    </div>
  </div>
</Layout>
